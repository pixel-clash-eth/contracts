pragma solidity ^0.8.28;

struct ReferralRevenue {
  address referrer;
  uint256 revenue;
}

/// @notice A data structure to efficiently manage referrers and retrieve the top three by revenue
///   in O(1).
struct ReferralHeap {
  /// A priority queue of referrers ordered by generated revenue in descending order. The queue is
  /// managed as a max-heap (see https://en.wikipedia.org/wiki/Binary_heap).
  ReferralRevenue[] queue;
  /// Associates each referrer with its respective index in the queue. The indices stored in this
  /// mapping are 1-based, not zero-based, because all values of a mapping are always initialized to
  /// zero, so if our indices were zero-based all referrers would refer to the first element of the
  /// queue by default, which is wrong.
  mapping(address => uint64) indices;
}

library ReferralHeapMethods {
  function swap(ReferralHeap storage heap, uint64 i, uint64 j) private {
    ReferralRevenue memory element1 = heap.queue[i];
    ReferralRevenue memory element2 = heap.queue[j];
    heap.indices[element1.referrer] = j + 1;
    heap.indices[element2.referrer] = i + 1;
    heap.queue[i] = element2;
    heap.queue[j] = element1;
  }

  function siftUp(ReferralHeap storage heap, uint64 index) private returns (uint64) {
    while (index > 0) {
      uint64 parentIndex = (index - 1) / 2;
      if (heap.queue[index].revenue > heap.queue[parentIndex].revenue) {
        swap(heap, index, parentIndex);
        index = parentIndex;
      } else {
        return index;
      }
    }
    return 0;
  }

  /// @notice Returns the number of elements in the heap -- that is, the number of different
  ///   referrers (not referrals!).
  function length(ReferralHeap storage heap) internal view returns (uint256) {
    return heap.queue.length;
  }

  /// @notice Records a piece of revenue generated by a referrer, returning the total revenue
  ///   generated so far by that referrer.
  /// @param heap The heap data structure.
  /// @param referrer The referrer.
  /// @param revenue The newly generated revenue.
  /// @return The total revenue generated by the referrer so far.
  function addReferral(
    ReferralHeap storage heap,
    address referrer,
    uint256 revenue
  ) internal returns (uint256) {
    uint64 index = heap.indices[referrer];
    if (index != 0) {
      --index;
      heap.queue[index].revenue += revenue;
    } else {
      assert(heap.queue.length < uint256(type(uint64).max));
      index = uint64(heap.queue.length);
      heap.queue.push(ReferralRevenue({referrer: referrer, revenue: revenue}));
      heap.indices[referrer] = index + 1;
    }
    index = siftUp(heap, index);
    return heap.queue[index].revenue;
  }

  /// @notice Returns the referral revenue generated by a specific referrer.
  /// @dev Returns zero if the specified address hasn't referred any purchase.
  /// @param heap The heap data structure.
  /// @param referrer The queried referrer address.
  /// @return The generated revenue.
  function getRevenueFrom(
    ReferralHeap storage heap,
    address referrer
  ) internal view returns (uint256) {
    uint256 index = heap.indices[referrer];
    if (index != 0) {
      return heap.queue[index - 1].revenue;
    } else {
      return 0;
    }
  }

  function min(uint256 a, uint256 b) private pure returns (uint256) {
    return a < b ? a : b;
  }

  /// @notice Returns the top three referrers by generated revenue, along with their respective
  ///   generated revenues.
  /// @dev The returned elements are sorted in descending order (ie. the first one is the top
  ///   referrer, the one that generated the most revenue).
  /// @dev Note that less than 3 elements may be returned if an arena has had less than 3 referrers
  ///   (not referrals!) so far. For this function to return at least 3 elements, at least 3
  ///   different addresses must have successfully referred other players.
  /// @param heap The heap data structure.
  /// @return referrers The 3 referrers.
  function getTop3(
    ReferralHeap storage heap
  ) internal view returns (ReferralRevenue[] memory referrers) {
    uint256 count = min(3, heap.queue.length);
    referrers = new ReferralRevenue[](count);
    if (count > 0) {
      referrers[0] = heap.queue[0];
    }
    if (count > 2) {
      if (heap.queue[2].revenue > heap.queue[1].revenue) {
        referrers[1] = heap.queue[2];
        referrers[2] = heap.queue[1];
      } else {
        referrers[1] = heap.queue[1];
        referrers[2] = heap.queue[2];
      }
      for (uint256 i = 3; i < min(7, heap.queue.length); ++i) {
        if (heap.queue[i].revenue > referrers[2].revenue) {
          referrers[2] = heap.queue[i];
        }
      }
    } else if (count > 1) {
      referrers[1] = heap.queue[1];
    }
  }
}
