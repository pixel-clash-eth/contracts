pragma solidity ^0.8.28;

import {SafeCast} from "@openzeppelin/contracts/utils/math/SafeCast.sol";

/// @notice A referrer and the revenue generated through their referrals, packed in one slot.
/// @dev 96 bits allow ~7.9e28 base units, ie. 79 billion tokens with 18 decimals, per referrer per
///   arena. Larger values revert instead of overflowing.
struct ReferralRevenue {
  address referrer;
  uint96 revenue;
}

/// @notice Keeps track of all referrers of an arena and of the top three by revenue.
/// @dev Revenue only ever grows, so a referrer can only enter the top three when its own revenue
///   grows, and it is enough to compare it with the current third place at that moment. This
///   keeps every update O(1), with no data structure ordering all referrers.
struct Referrals {
  /// Referrers in order of first referral. The 1-based index of a referrer is its stable ID, which
  /// is what pixel ranges store instead of the full address.
  ReferralRevenue[] referrers;
  /// 1-based referrer IDs indexed by address.
  mapping(address => uint256) ids;
  /// IDs of the top three referrers in descending order of revenue, `TOP_ID_BITS` bits each, with
  /// zero meaning an empty place. Ties keep the referrer that got there first.
  uint256 top;
}

uint256 constant TOP_ID_BITS = 64;

library ReferralMethods {
  /// @notice Returns the number of different referrers (not referrals!).
  function length(Referrals storage self) internal view returns (uint256) {
    return self.referrers.length;
  }

  /// @notice Returns the address of the referrer with the given ID, or the zero address for ID 0.
  function referrerOf(Referrals storage self, uint256 id) internal view returns (address) {
    return id == 0 ? address(0) : self.referrers[id - 1].referrer;
  }

  function topAt(uint256 top, uint256 place) private pure returns (uint256) {
    return uint64(top >> (place * TOP_ID_BITS));
  }

  function revenueOf(Referrals storage self, uint256 id) private view returns (uint256) {
    return self.referrers[id - 1].revenue;
  }

  /// @notice Records a piece of revenue generated by a referrer.
  /// @param referrer The referrer. Must not be the zero address.
  /// @param revenue The newly generated revenue.
  /// @return id The referrer's ID.
  function addReferral(
    Referrals storage self,
    address referrer,
    uint256 revenue
  ) internal returns (uint256 id) {
    id = self.ids[referrer];
    if (id == 0) {
      self.referrers.push(ReferralRevenue({referrer: referrer, revenue: 0}));
      id = self.referrers.length;
      self.ids[referrer] = id;
    }
    ReferralRevenue storage record = self.referrers[id - 1];
    uint256 total = record.revenue + revenue;
    record.revenue = SafeCast.toUint96(total);

    uint256 top = self.top;
    uint256[3] memory places = [topAt(top, 0), topAt(top, 1), topAt(top, 2)];
    uint256 place = 3;
    for (uint256 i = 0; i < 3; ++i) {
      if (places[i] == id) {
        place = i;
      }
    }
    if (place == 3) {
      if (places[2] != 0 && revenueOf(self, places[2]) >= total) {
        return id;
      }
      place = 2;
      places[2] = id;
    }
    while (place > 0 && (places[place - 1] == 0 || revenueOf(self, places[place - 1]) < total)) {
      (places[place - 1], places[place]) = (places[place], places[place - 1]);
      --place;
    }
    uint256 newTop = places[0] | (places[1] << TOP_ID_BITS) | (places[2] << (2 * TOP_ID_BITS));
    if (newTop != top) {
      self.top = newTop;
    }
  }

  /// @notice Returns the referral revenue generated by a specific referrer.
  /// @dev Returns zero if the specified address hasn't referred any purchase.
  function getRevenueFrom(
    Referrals storage self,
    address referrer
  ) internal view returns (uint256) {
    uint256 id = self.ids[referrer];
    return id == 0 ? 0 : revenueOf(self, id);
  }

  /// @notice Returns the top three referrers by generated revenue, along with their respective
  ///   generated revenues.
  /// @dev The returned elements are sorted in descending order (ie. the first one is the top
  ///   referrer, the one that generated the most revenue).
  /// @dev Note that less than 3 elements may be returned if an arena has had less than 3 referrers
  ///   (not referrals!) so far.
  function getTop3(
    Referrals storage self
  ) internal view returns (ReferralRevenue[] memory referrers) {
    uint256 top = self.top;
    uint256 count = 0;
    while (count < 3 && topAt(top, count) != 0) {
      ++count;
    }
    referrers = new ReferralRevenue[](count);
    for (uint256 i = 0; i < count; ++i) {
      referrers[i] = self.referrers[topAt(top, i) - 1];
    }
  }
}
