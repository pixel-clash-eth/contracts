{
  "name": "@pixel-clash/contracts",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "lint": "hardhat check",
    "build": "hardhat compile",
    "test": "hardhat test --network hardhat",
    "local:node": "hardhat node --hostname 127.0.0.1 --port 8545",
    "local:deploy": "hardhat run scripts/local/deploy.ts --network localhost",
    "local:reset": "hardhat run scripts/local/reset.ts --network localhost",
    "local:smoke": "hardhat run scripts/local/smoke.ts --network localhost",
    "local:fulfill": "hardhat run scripts/local/fulfill.ts --network localhost",
    "local:timeout": "hardhat run scripts/local/timeout.ts --network localhost",
    "local:fund": "hardhat run scripts/local/fund.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomiclabs/hardhat-solhint": "^4.1.2",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "chai": "^4.5.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-gas-reporter": "^2.3.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.3.1",
    "solc": "^0.8.34",
    "solhint": "^6.1.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v4-core": "^1.0.2"
  }
}
